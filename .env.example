# Copy to .env and fill in.
#
# Create an app at https://developer.spotify.com/dashboard
#   Redirect URIs:  http://127.0.0.1:5173/callback   (plus your deployed origin)
#   APIs used:      Web API, Web Playback SDK
#
# The client ID is public by design — this app uses PKCE, so there is no secret.
VITE_SPOTIFY_CLIENT_ID=

# ── Deck builder only (scripts/build-deck.ts) ────────────────────────────────
# The playlist the deck is built from. Must be one YOU own: Development Mode
# apps cannot read another user's playlist.
DECK_PLAYLIST_ID=6xyl53KqlMCNioHGWGVNmv

# Abort the build if the playlist yields fewer tracks than this, so a truncated
# copy or a broken pagination loop fails loudly instead of shipping a short deck.
DECK_MIN_TRACKS=100
